<?xml version="1.0" ?>
<sdf version="1.7">
    <model name='vehicle_blue_scaled' canonical_link='chassis'>
        <pose>0 0 0 0 0 0</pose>

        <!--chassis-->
        <link name='chassis'>
            <pose relative_to='__model__'>0 0 0.1 0 0 -1.5708</pose>
            <inertial>
                <mass>15.0</mass>
                <inertia>
                    <ixx>1.05</ixx>
                    <iyy>1.05</iyy>
                    <izz>1.08</izz>
                </inertia>
            </inertial>

            <visual name='visual'>
                <geometry>
                    <box>
                        <size>0.5 0.25 0.125</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                    <specular>0 0 1 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <box>
                        <size>0.5 0.25 0.125</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <!--Left wheel-->
        <link name='left_wheel'>
            <pose relative_to="chassis">-0.125 0.15 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.016</mass>
                <inertia>
                    <ixx>0.0007</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0007</iyy>
                    <iyz>0</iyz>
                    <izz>0.0013</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>1 0 0 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>5.0</mu>
                            <mu2>5.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>

        <!--Right wheel-->
        <link name='right_wheel'>
            <pose relative_to="chassis">-0.125 -0.15 0 -1.5707 0 0</pose>
            <inertial>
                <mass>0.016</mass>
                <inertia>
                    <ixx>0.0007</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0007</iyy>
                    <iyz>0</iyz>
                    <izz>0.0013</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>1 0 0 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>5.0</mu>
                            <mu2>5.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>

        <!--Caster wheel-->
        <frame name="caster_frame" attached_to='chassis'>
            <pose>0.2 0 -.05 0 0 0</pose>
        </frame>

        <link name='caster'>
            <pose relative_to='caster_frame'/>
            <inertial>
                <mass>0.0004</mass>
                <inertia>
                    <ixx>2.5e-4</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>2.5e-4</iyy>
                    <iyz>0</iyz>
                    <izz>2.5e-4</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <box>
                        <size>0.1 0.1 0.1</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>1 0 0 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <box>
                        <size>0.1 0.1 0.1</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.0</mu>
                            <mu2>0.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>

        <!--Joints-->
        <joint name='left_wheel_joint' type='fixed'>
            <pose relative_to='left_wheel'/>
            <parent>chassis</parent>
            <child>left_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>1 0 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <joint name='right_wheel_joint' type='fixed'>
            <pose relative_to='right_wheel'/>
            <parent>chassis</parent>
            <child>right_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>1 0 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <joint name='caster_wheel' type='fixed'>
            <parent>chassis</parent>
            <child>caster</child>
        </joint>
    </model>
</sdf>