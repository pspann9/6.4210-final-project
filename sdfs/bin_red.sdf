<?xml version="1.0"?>
<sdf version="1.7">
  <model name="bin_model">
    <!--
    Axes:
      +X - Pointing towards front (slope)
      +Y - Pointing to left side
      +Z - Up
    Origin:
      (0, 0, 0) at the center bottom of the bin
    -->
    <link name="bin_base">
      <inertial>
        <!-- mass and inertia roughly scaled by 0.5^3 and 0.5^5 -->
        <mass>2.34</mass>
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.017</iyy>
          <iyz>0</iyz>
          <izz>0.038</izz>
        </inertia>
      </inertial>

      <!-- front wall -->
      <visual name="front">
        <pose>0.11 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="front">
        <pose>0.11 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- slope wall -->
      <visual name="slope">
        <pose>0.091 0 0.051 0 0.35 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="slope">
        <pose>0.091 0 0.051 0 0.35 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- back wall -->
      <visual name="back">
        <pose>-0.11 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="back">
        <pose>-0.11 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.315 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- left wall -->
      <visual name="left">
        <pose>0 0.145 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.025 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="left">
        <pose>0 0.145 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.025 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- right wall -->
      <visual name="right">
        <pose>0 -0.145 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.025 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="right">
        <pose>0 -0.145 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.025 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- bottom -->
      <visual name="bottom">
        <pose>0.0 0.0 0.00375 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.315 0.0075</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="bottom">
        <pose>0.0 0.0 0.00375 0 0 0</pose>
        <geometry>
          <box>
            <size>0.245 0.315 0.0075</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- front top center frame (scaled) -->
    <frame name="bin_front_top_center">
      <pose relative_to="bin_base">0.11 0 0.105 0 0 0</pose>
    </frame>
  </model>
</sdf>


